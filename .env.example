# Copy to .env (gitignored) and fill in. Everything has a working default:
# with no keys at all, the app runs locally with Ollama or deterministic heuristics.

# ==============================================================================
# 3-LAYER ZERO-JUDGE SECURITY PIPELINE CONFIGURATION
# Layer 1: 3-Stage Deterministic Funnel (1A Normalizer -> 1B Aho-Corasick -> 1C Regex)
# Layer 2: Quarantined Intent Extractor & Neutralizer (JSON schema, zero tool access)
# Layer 3: Deterministic Policy & Symbolic Gate (Zero AI, 100% deterministic RBAC/ABAC)
# ==============================================================================

# --- Layer 2 Intent Extractor Provider Strategy ------------------------------
# LAYER2_PROVIDER: auto (recommended) | gemini | ollama | heuristic
# - auto: Uses Gemini if GEMINI_API_KEY set; else Ollama if running; else Heuristic fallback
# - gemini: Free-tier Google AI Studio key (recommended for live production)
# - ollama: Local offline models (recommended for local development)
# - heuristic: Pure deterministic keyword/pattern extractor (zero keys, zero models)
LAYER2_PROVIDER=auto
LAYER2_ALLOW_HEURISTIC_FALLBACK=true   # true = allow graceful fallback for free testing

# --- Gemini (Free Tier Production — No Billing Required) ----------------------
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest    # Primary fast structured extractor
GEMINI_FALLBACK_MODEL=gemini-flash-latest  # Automatic rate-limit retry model on 429

# --- Ollama (Local Development) -----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b                 # qwen2.5:3b | llama3.2:3b | phi4-mini

# --- Assistant Chat Reply Model ----------------------------------------------
CHAT_PROVIDER=auto                     # auto | gemini | ollama | stub
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
CHAT_OLLAMA_MODEL=auto

# --- Funnel Fail Modes --------------------------------------------------------
CHAT_FAIL_MODE=open
DOC_FAIL_MODE=closed

# --- Public Demo Settings (Hosted Link) ---------------------------------------
PUBLIC_DEMO=0                          # 1 = per-visitor request budget below
DEMO_REQUEST_LIMIT=4                   # chat messages + uploads per visitor
DEMO_IP_LIMIT=12                       # per network address (shared offices)
DEMO_DAILY_LIMIT=250                   # whole site, per UTC day
DEMO_RESET_MINUTES=20                  # reseed the shared demo account when idle
UPLOAD_MAX_MB=10
TRUST_PROXY=0

# --- RAG & Parsing ------------------------------------------------------------
PARSER=pymupdf                         # pymupdf (fast) or docling (layout + tables + OCR)
ENRICH_CONTEXT=false
MIN_RELEVANCE=0.3

# --- App Services -------------------------------------------------------------
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me-too
SHIELD_URL=                            # empty = run the funnel in-process
